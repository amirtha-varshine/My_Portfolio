<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
    <defs>
      <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#0A0B1E"/>
        <stop offset="50%" stop-color="#14152C"/>
        <stop offset="100%" stop-color="#1F0D24"/>
      </linearGradient>
      <linearGradient id="pinkGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#FF2E93"/>
        <stop offset="100%" stop-color="#FF6FB5"/>
      </linearGradient>
      <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="15" result="blur"/>
        <feComposite in="SourceGraphic" in2="blur" operator="over"/>
      </filter>
    </defs>
    <rect width="800" height="500" fill="url(#bg)" rx="24"/>
    <rect x="20" y="20" width="760" height="460" fill="none" stroke="#2A2B45" stroke-width="2" rx="18"/>
    <rect x="36" y="36" width="728" height="428" fill="none" stroke="#FF2E93" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="6 6" rx="12"/>
    
    <!-- Floral watermark -->
    <path d="M720 80 C680 70 660 110 690 140 C660 170 700 200 730 170 C760 200 800 170 770 140 C800 110 760 70 730 100 Z" fill="#FF2E93" opacity="0.12"/>
    <path d="M80 420 C50 400 30 430 60 450 C40 480 70 490 90 470 C110 490 140 470 120 440 C140 410 110 390 90 410 Z" fill="#FF6FB5" opacity="0.12"/>
    
    <!-- Header -->
    <text x="70" y="100" fill="#FF6FB5" font-family="sans-serif" font-size="14" font-weight="700" letter-spacing="3">CERTIFICATE OF ACHIEVEMENT</text>
    <rect x="660" y="75" width="70" height="30" rx="15" fill="#FF2E93" fill-opacity="0.2" stroke="#FF2E93" stroke-width="1"/>
    <text x="695" y="95" fill="#FF2E93" font-family="sans-serif" font-size="14" font-weight="700" text-anchor="middle">2025</text>

    <!-- Certificate Title -->
    <text x="70" y="180" fill="#FFFFFF" font-family="sans-serif" font-size="32" font-weight="800">Computer Graphics</text>
    <text x="70" y="225" fill="#C4C4D6" font-family="sans-serif" font-size="18">Issued by <tspan fill="#FF6FB5" font-weight="700">SWAYAM NPTEL</tspan></text>

    <!-- Decorative divider -->
    <line x1="70" y1="270" x2="350" y2="270" stroke="url(#pinkGrad)" stroke-width="3" stroke-linecap="round"/>

    <!-- Details -->
    <text x="70" y="320" fill="#999AB8" font-family="sans-serif" font-size="15">Recipient:</text>
    <text x="70" y="350" fill="#FFFFFF" font-family="sans-serif" font-size="22" font-weight="700">Amirthavarshine S</text>
    <text x="70" y="390" fill="#C4C4D6" font-family="sans-serif" font-size="14">Domain: Graphics & Rendering • Verified Credential</text>

    <!-- Seal badge -->
    <g transform="translate(640, 340)">
      <circle cx="50" cy="50" r="45" fill="#14152C" stroke="#FF2E93" stroke-width="2"/>
      <circle cx="50" cy="50" r="38" fill="none" stroke="#FF6FB5" stroke-dasharray="4 3" stroke-width="1.5"/>
      <text x="50" y="46" fill="#FF6FB5" font-family="sans-serif" font-size="11" font-weight="700" text-anchor="middle">OFFICIAL</text>
      <text x="50" y="62" fill="#FFFFFF" font-family="sans-serif" font-size="10" text-anchor="middle">VERIFIED</text>
    </g>
  </svg>